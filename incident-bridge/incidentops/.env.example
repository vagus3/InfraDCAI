# Optional external triage service. It receives the incident and returns a TriageResult.
INCIDENTOPS_TRIAGE_WEBHOOK_URL=

# Optional coding workflow (Codex, GitHub automation, n8n, etc.).
INCIDENTOPS_FIX_WEBHOOK_URL=

# Optional webhook for operator/customer notifications.
INCIDENTOPS_NOTIFY_WEBHOOK_URL=

# SMTP can be used instead of a notification webhook.
INCIDENTOPS_SMTP_HOST=
INCIDENTOPS_SMTP_PORT=587
INCIDENTOPS_SMTP_USERNAME=
INCIDENTOPS_SMTP_PASSWORD=
INCIDENTOPS_SMTP_FROM=
INCIDENTOPS_SMTP_TO=
INCIDENTOPS_SMTP_STARTTLS=true
